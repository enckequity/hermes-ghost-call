# Copy to your Hermes env (never commit real values). Names are what the plugin reads.
OPENAI_API_KEY=
PUBLIC_BASE_URL=http://localhost:8766
# Twilio mode only (optional; incomplete Twilio config falls back to web mode):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Developer-only:
HERMES_GHOST_TEST_ALLOWLIST=
# Shared bridge (plugin side). With the URL and a credential set, sessions run on the shared
# bridge. Credential: GHOST_CALL_BRIDGE_TOKEN (owner), else the usage token plus workspace name.
GHOST_CALL_BRIDGE_URL=
GHOST_CALL_BRIDGE_TOKEN=
TEAMSHIFT_USAGE_TOKEN=
TEAMSHIFT_WORKSPACE_NAME=
OPENROUTER_API_KEY=
# Shared bridge (bridge side), plain env. Secrets (OPENAI_API_KEY, GHOST_CALL_TELNYX_API_KEY,
# GHOST_CALL_TELNYX_PUBLIC_KEY, GHOST_CALL_BRIDGE_SIGNING_KEY) are files in CREDENTIALS_DIRECTORY.
GHOST_CALL_BRIDGE_PUBLIC_URL=
GHOST_CALL_BRIDGE_AUTH_URL=
# Optional: {"<workspace>": {"hint_model": "...", "daily_session_limit": 20, "disabled": true}}
GHOST_CALL_BRIDGE_OVERRIDES=
GHOST_CALL_TELNYX_CONNECTION_ID=
GHOST_CALL_CALLER_NUMBER=
CREDENTIALS_DIRECTORY=
