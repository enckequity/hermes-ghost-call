# Copy to your Hermes env (never commit real values). Names are what the plugin reads.
OPENAI_API_KEY=
PUBLIC_BASE_URL=http://localhost:8766
# Twilio mode only (optional; incomplete Twilio config falls back to web mode):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Developer-only:
HERMES_GHOST_TEST_ALLOWLIST=
