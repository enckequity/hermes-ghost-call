# Copy to your Hermes env (never commit real values). Names are what the plugin reads.
OPENAI_API_KEY=
PUBLIC_BASE_URL=http://localhost:8766
# Twilio mode only (optional; incomplete Twilio config falls back to web mode):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Developer-only:
HERMES_GHOST_TEST_ALLOWLIST=
# Shared bridge (plugin side). When both are set, sessions run on the shared bridge:
GHOST_CALL_BRIDGE_URL=
GHOST_CALL_BRIDGE_TOKEN=
OPENROUTER_API_KEY=
# Shared bridge (bridge side). Tenants: {"<sha256 of token>": {"workspace": "...",
#   "hint_base_url": "https://...", "hint_model": "...", "daily_session_limit": 20}}
GHOST_CALL_BRIDGE_TENANTS=
GHOST_CALL_TELNYX_API_KEY=
GHOST_CALL_TELNYX_CONNECTION_ID=
GHOST_CALL_TELNYX_PUBLIC_KEY=
GHOST_CALL_CALLER_NUMBER=
